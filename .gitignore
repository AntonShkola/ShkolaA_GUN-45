# ====================== UNITY GENERATED ======================
/Library/
/Temp/
/Obj/
/Build/
/Builds/
/Logs/
/UserSettings/
/MemoryCaptures/

# ====================== PACKAGES & PLUGINS ======================
# UPM-пакеты (Zenject, Extenject и любые другие)
!/Packages/
!/Packages/**/*

# Классические плагины (если Zenject лежит в Assets)
!/Assets/Plugins/
!/Assets/Plugins/**/*
!/Assets/Zenject/
!/Assets/Zenject/**/*

# ====================== META-ФАЙЛЫ ======================
# Разрешаем все .meta (очень важно!)
!**/*.meta

# ====================== ОСНОВНЫЕ ИГНОРЫ ======================
# Windows
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Общие
*.log
*.tmp
.DS_Store