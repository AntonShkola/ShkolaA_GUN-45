# === Unity Generated & Temporary (игнорируем) ===
/Library/
/Temp/
/Obj/
/Build/
/Builds/
/Logs/
/UserSettings/
/MemoryCaptures/

# === Важные папки (явно включаем — то, что тебе нужно) ===
!/Packages/
!/Packages/**/*
!/ProjectSettings/
!/ProjectSettings/**/*

# === Плагины Zenject (на всякий случай) ===
!/Assets/Plugins/
!/Assets/Plugins/**/*
!/Assets/Zenject/
!/Assets/Zenject/**/*

# === Meta-файлы (обязательно включаем) ===
!**/*.meta

# === ОС и мусор ===
.DS_Store
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.log
*.tmp